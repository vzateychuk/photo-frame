NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PHOTOS_DIR=/path/to/your/photos
LOG_LEVEL=info

# Background rescan of PHOTOS_DIR (milliseconds). Default 600000 = 10 minutes.
# PHOTO_SCAN_INTERVAL_MS=600000

# Optional public site URL for prepared slideshow links in the catalog.
# PUBLIC_BASE_URL=https://photos.example.com

# Path to access-key JSON store (default: /data/state/keystore.json).
# KEYSTORE_FILE=/data/state/keystore.json

# Secret for GET /api/catalog (and later /api/keys, /catalog). Min 32 characters.
# If unset, the server still starts, but those routes are not registered (404).
# For local checks of /api/catalog this must be set, then restart the server.
ADMIN_TOKEN=replace-with-at-least-32-characters
